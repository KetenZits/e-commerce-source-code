generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(191)
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          Role      @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  reviews   Review[]
  addresses Address[]
  cartItems CartItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(191)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique @db.VarChar(191)
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique @db.VarChar(191)
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique @db.VarChar(191)
  title          String
  description    String        @db.Text
  basePriceCents Int
  currency       String        @default("THB") @db.VarChar(8)
  categoryId     String
  brand          String
  images         Json
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  reviews  Review[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([brand])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique @db.VarChar(191)
  attributes Json
  priceCents Int
  stockQty   Int     @default(0)
  weightGrams Int    @default(0)
  imageUrl   String? @db.Text

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([stockQty])
}

model CartItem {
  id               String   @id @default(cuid())
  userId           String?
  sessionId        String?  @db.VarChar(191)
  productVariantId String
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([productVariantId])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  recipientName String
  phone        String
  addressLine1 String
  addressLine2 String?
  subdistrict  String
  district     String
  province     String
  postalCode   String
  isDefault    Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model ShippingZone {
  id             String  @id @default(cuid())
  name           String
  provinces      Json
  minWeightGrams Int     @default(0)
  maxWeightGrams Int?
  feeCents       Int
  sortOrder      Int     @default(0)
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  addressId       String?
  status          OrderStatus @default(PENDING)
  subtotalCents   Int
  shippingFeeCents Int
  totalCents      Int
  currency        String      @default("THB") @db.VarChar(8)
  promptpayRef    String      @unique @db.VarChar(191)
  slipImageUrl    String?     @db.Text
  slipUncertain   Boolean     @default(false)
  verifiedAt      DateTime?
  expiresAt       DateTime
  trackingNumber  String?
  shippingCarrier String?
  shippingName    String?
  estimatedDelivery String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address?   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id                        String @id @default(cuid())
  orderId                   String
  productVariantId          String
  quantity                  Int
  unitPriceCents            Int
  productTitleSnapshot      String
  variantAttributesSnapshot Json

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model NotificationLog {
  id      String             @id @default(cuid())
  channel String
  event   String
  payload Json
  status  NotificationStatus @default(QUEUED)
  error   String?            @db.Text
  sentAt  DateTime?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}
