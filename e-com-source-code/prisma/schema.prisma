generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  ADMIN
  CATALOG_MANAGER
  ORDER_MANAGER
  FINANCE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentType {
  PHYSICAL
  DIGITAL
  MIXED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InventoryMovementType {
  RESERVATION
  RESERVATION_RELEASE
  SALE
  RESTOCK
  ADJUSTMENT
  REFUND
}

enum DigitalCodeStatus {
  AVAILABLE
  RESERVED
  DELIVERED
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(191)
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          Role      @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  reviews   Review[]
  addresses Address[]
  cartItems CartItem[]
  wishlistItems WishlistItem[]
  productDraft ProductDraft?
  authTokens AuthToken[]
  auditLogs AuditLog[] @relation("AuditActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(191)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique @db.VarChar(191)
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique @db.VarChar(191)
  parentId String?
  description String? @db.Text
  seoTitle String?
  seoDescription String? @db.Text
  sortOrder Int @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([sortOrder, name])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique @db.VarChar(191)
  title          String
  description    String        @db.Text
  basePriceCents Int
  currency       String        @default("THB") @db.VarChar(8)
  categoryId     String
  brand          String
  images         Json
  imageAltTexts  Json?
  status         ProductStatus @default(DRAFT)
  fulfillmentType FulfillmentType @default(PHYSICAL)
  seoTitle       String?
  seoDescription String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  reviews  Review[]
  wishlistItems WishlistItem[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([brand])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique @db.VarChar(191)
  attributes Json
  priceCents Int
  stockQty   Int     @default(0)
  reservedQty Int   @default(0)
  weightGrams Int    @default(0)
  imageUrl   String? @db.Text

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
  inventoryMovements InventoryMovement[]
  digitalCodes DigitalCode[]

  @@index([productId])
  @@index([stockQty])
}

model CartItem {
  id               String   @id @default(cuid())
  userId           String?
  sessionId        String?  @db.VarChar(191)
  productVariantId String
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([productVariantId])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  recipientName String
  phone        String
  addressLine1 String
  addressLine2 String?
  subdistrict  String
  district     String
  province     String
  postalCode   String
  isDefault    Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model ShippingZone {
  id             String  @id @default(cuid())
  name           String
  provinces      Json
  minWeightGrams Int     @default(0)
  maxWeightGrams Int?
  feeCents       Int
  sortOrder      Int     @default(0)
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  addressId       String?
  status          OrderStatus @default(PENDING)
  fulfillmentType FulfillmentType @default(PHYSICAL)
  subtotalCents   Int
  discountCents   Int         @default(0)
  taxCents        Int         @default(0)
  taxRateBps      Int         @default(0)
  billingDetails  Json?
  shippingFeeCents Int
  totalCents      Int
  currency        String      @default("THB") @db.VarChar(8)
  promotionCode   String?     @db.VarChar(64)
  guestEmail      String?     @db.VarChar(191)
  guestName       String?
  guestPhone      String?
  guestAccessTokenHash String? @unique @db.VarChar(191)
  idempotencyKey  String?     @unique @db.VarChar(191)
  promptpayRef    String      @unique @db.VarChar(191)
  slipImageUrl    String?     @db.Text
  slipUncertain   Boolean     @default(false)
  verifiedAt      DateTime?
  expiresAt       DateTime
  trackingNumber  String?
  shippingCarrier String?
  shippingName    String?
  estimatedDelivery String?
  digitalDeliveryEncrypted String? @db.Text
  digitalDeliveredAt DateTime?
  invoiceNumber   String?     @unique @db.VarChar(64)
  cancelledAt     DateTime?
  refundedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  statusEvents OrderStatusEvent[]
  payments PaymentTransaction[]
  refunds Refund[]
  inventoryMovements InventoryMovement[]

  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id                        String @id @default(cuid())
  orderId                   String
  productVariantId          String
  quantity                  Int
  unitPriceCents            Int
  discountCents             Int    @default(0)
  taxCents                  Int    @default(0)
  fulfillmentTypeSnapshot   FulfillmentType @default(PHYSICAL)
  productTitleSnapshot      String
  variantAttributesSnapshot Json

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  digitalCodes DigitalCode[]

  @@index([orderId])
}

model NotificationLog {
  id      String             @id @default(cuid())
  channel String
  event   String
  payload Json
  status  NotificationStatus @default(QUEUED)
  error   String?            @db.Text
  attemptCount Int           @default(0)
  nextAttemptAt DateTime?
  sentAt  DateTime?

  @@index([status, nextAttemptAt])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String   @db.Text
  status    ReviewStatus @default(PENDING)
  verifiedPurchase Boolean @default(false)
  adminNote String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
}

model StoreSetting {
  key   String @id @db.VarChar(64)
  value String @db.Text
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ProductDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id         String    @id @default(cuid())
  userId     String
  type       String    @db.VarChar(32)
  tokenHash  String    @unique @db.VarChar(191)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Promotion {
  id               String       @id @default(cuid())
  code             String       @unique @db.VarChar(64)
  name             String
  description      String?      @db.Text
  type             DiscountType
  value            Int
  minSubtotalCents Int          @default(0)
  maxDiscountCents Int?
  usageLimit       Int?
  usageCount       Int          @default(0)
  active           Boolean      @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([active, startsAt, endsAt])
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  orderId         String
  provider        String        @db.VarChar(32)
  status          PaymentStatus @default(PENDING)
  amountCents     Int
  currency        String        @default("THB") @db.VarChar(8)
  externalRef     String?       @unique @db.VarChar(191)
  slipFingerprint String?       @unique @db.VarChar(191)
  raw             Json?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  amountCents Int
  reason      String       @db.Text
  status      RefundStatus @default(REQUESTED)
  requestedBy String?
  decidedBy   String?
  decidedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  variantId String
  orderId   String?
  type      InventoryMovementType
  quantity  Int
  note      String?
  actorId   String?
  createdAt DateTime              @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model DigitalCode {
  id               String            @id @default(cuid())
  variantId        String
  orderItemId      String?
  encryptedContent String            @db.Text
  status           DigitalCodeStatus @default(AVAILABLE)
  reservedAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([variantId, status])
  @@index([orderItemId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(96)
  entityType String   @db.VarChar(64)
  entityId   String?
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
